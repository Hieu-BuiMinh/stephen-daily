{
	"name": "stephen-news",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"build:stephen-daily": "turbo run build --filter=stephen-daily...",
		"build:docs": "turbo run build --filter=docs...",
		"dev": "turbo run dev",
		"dev:stephen-daily": "turbo run dev --filter=stephen-daily",
		"dev:docs": "turbo run dev --filter=docs",
		"start:stephen-daily": "pnpm --filter stephen-daily run start --port 3000",
		"start:docs": "pnpm --filter docs run start --port 3001",
		"lint": "eslint . --max-warnings 0 && turbo run lint",
		"lint:check": "pnpm run lint",
		"lint:fix": "eslint . --fix --max-warnings 0 && turbo run lint --force -- --fix",
		"lint:stephen-daily": "turbo run lint --filter=stephen-daily...",
		"lint:docs": "turbo run lint --filter=docs...",
		"format": "prettier --write .",
		"format:staged": "lint-staged",
		"check-types": "turbo run check-types",
		"check-types:stephen-daily": "turbo run check-types --filter=stephen-daily...",
		"check-types:docs": "turbo run check-types --filter=docs...",
		"check": "pnpm run format:check && pnpm run lint && pnpm run check-types",
		"format:check": "prettier --check .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@colbymchenry/codegraph": "^1.6.2",
		"@repo/stephen-eslint-config": "workspace:*",
		"eslint": "9.39.5",
		"husky": "9.1.7",
		"lint-staged": "16.2.7",
		"prettier": "3.9.6",
		"turbo": "^2.11.10",
		"typescript": "6.0.3"
	},
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": ">=22.15.0 <25"
	}
}
