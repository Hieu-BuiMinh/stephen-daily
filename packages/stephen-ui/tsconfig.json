{
	"extends": "@repo/stephen-typescript-config/react-library.json",
	"compilerOptions": {
		"outDir": "dist",
		"strictNullChecks": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
